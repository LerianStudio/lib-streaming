# =============================================================================
# lib-streaming — Environment Variable Reference
# =============================================================================
#
# This file documents every environment variable that lib-streaming reads at
# runtime.  Copy this file, remove the comments, and fill in values for your
# deployment.  Variables marked (required) have no usable default and MUST be
# set for the corresponding subsystem to start.
#
# Evaluation order:
#   1. Explicit struct/function parameters always win (code-level config).
#   2. Environment variables act as fallbacks when code-level config is empty.
#   3. Defaults listed here apply when the env var is unset or empty.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Streaming (multi-transport CloudEvents producer)
# -----------------------------------------------------------------------------
# CloudEvents-framed domain event publisher to Kafka, SQS, RabbitMQ, and
# EventBridge with per-target circuit breakers, route-aware outbox fallback,
# and per-route DLQ.  LoadConfig reads every STREAMING_* variable below,
# applies the listed defaults, and validates the result.  When
# STREAMING_ENABLED=false, callers should use streaming.NewNoopEmitter() —
# Emit calls succeed silently.  Do not use NoopEmitter as the fallback for a
# missing broker secret in production; fail startup when streaming is required
# and the broker list is not explicitly configured.
#
# lib-streaming covers BOTH sides: event production (the STREAMING_* variables
# below) and at-least-once stream consumption (STREAMING_CONSUMER_*, further
# down).  It is orthogonal to
# github.com/LerianStudio/lib-commons/v7/commons/rabbitmq (internal command
# queues).  Neither deprecates the other.
#
# Multi-transport note: STREAMING_* variables below configure the Kafka
# transport.  Multi-target wiring (multiple Kafka clusters, SQS / RabbitMQ /
# EventBridge fan-out) is programmatic via streaming.Builder in code —
# non-Kafka destinations such as SQS queue URLs, RabbitMQ exchanges, or
# EventBridge bus names are typically already plumbed through the consuming
# service's own configuration.  See README.md "Multi-Transport Routing".

# Master kill switch.  When false, callers should use NewNoopEmitter and no
# broker connections are attempted; validation of the remaining fields is
# skipped.
# Type: bool
# Default: false
STREAMING_ENABLED=false

# Redpanda/Kafka bootstrap broker list (comma-separated host:port entries).
# Production deployments should set this explicitly whenever
# STREAMING_ENABLED=true. There is intentionally no localhost default: enabled
# configs with an empty broker list fail closed instead of silently publishing
# to a developer-local broker.
# A parsed empty list with Enabled=true returns ErrMissingBrokers from
# LoadConfig.
# Type: string (comma-separated)
# Default: empty
STREAMING_BROKERS=

# Kafka client.id reported to brokers for server-side diagnostics.  Empty
# means "derive from hostname" at the franz-go level.
# Type: string
# Default: ""
STREAMING_CLIENT_ID=

# franz-go ProducerLinger, in milliseconds.  Pinned explicitly because
# franz-go's default has flipped between versions; a silent latency change
# would be operationally catastrophic.  Negative values are rejected at
# bootstrap with ErrInvalidConfigField; zero is permitted (immediate
# flush).
# Type: int (milliseconds, non-negative)
# Default: 5
STREAMING_BATCH_LINGER_MS=5

# franz-go ProducerBatchMaxBytes, in bytes.  Caps the serialized record
# size; individual Event payloads over 1 MiB are rejected synchronously
# with ErrPayloadTooLarge.  Zero or negative is rejected at bootstrap with
# ErrInvalidConfigField — there is no "use the default" path through
# franz-go for this field.
# Type: int (bytes, must be > 0)
# Default: 1048576
STREAMING_BATCH_MAX_BYTES=1048576

# Maximum in-flight records before Emit applies backpressure.  Zero or
# negative is rejected at bootstrap with ErrInvalidConfigField.
# Type: int (must be > 0)
# Default: 10000
STREAMING_MAX_BUFFERED_RECORDS=10000

# Producer compression codec.  Invalid values return ErrInvalidCompression
# from LoadConfig.
# Valid values: snappy, lz4, zstd, gzip, none
# Type: string
# Default: lz4
STREAMING_COMPRESSION=lz4

# franz-go per-record retry budget before the record surfaces as an
# EmitError to the caller.  Negative values are rejected at bootstrap
# with ErrInvalidConfigField; zero disables retries.
# Type: int (non-negative)
# Default: 10
STREAMING_RECORD_RETRIES=10

# Per-record delivery cap, in seconds.  When exceeded, franz-go returns a
# timeout error classified as ClassNetworkTimeout (DLQ-routable).  Zero or
# negative is rejected at bootstrap with ErrInvalidConfigField.
# Type: int (seconds, must be > 0)
# Default: 30
STREAMING_RECORD_DELIVERY_TIMEOUT_S=30

# Broker ack requirement.  Invalid values return ErrInvalidAcks from
# LoadConfig.  "all" is the only durable setting; "leader" and "none"
# trade durability for lower latency.
# Valid values: all, leader, none
# Type: string
# Default: all
STREAMING_REQUIRED_ACKS=all

# Circuit-breaker trip threshold — fraction of failures over a sliding
# window that flips the breaker from CLOSED to OPEN.  Must be in (0.0, 1.0]
# when nonzero; values outside that range are rejected at bootstrap with
# ErrInvalidConfigField (a misconfigured ratio silently breaks gobreaker
# semantics).  Zero is permitted and falls through to the lib-commons HTTP
# preset (0.5).
# Type: float (0.0 < value <= 1.0, or 0 for preset fallback)
# Default: 0.5
STREAMING_CB_FAILURE_RATIO=0.5

# Minimum observations required before the CB evaluates the ratio.  Keeps
# the breaker from tripping on a single noisy failure at cold start.
# Negative values are rejected at bootstrap; zero falls through to the
# lib-commons HTTP preset (10).
# Type: int (non-negative; zero = preset fallback)
# Default: 10
STREAMING_CB_MIN_REQUESTS=10

# Circuit-breaker open -> half-open probe delay, in seconds.  Negative
# values are rejected at bootstrap with ErrInvalidConfigField; zero falls
# through to the lib-commons HTTP preset (30s).
# Type: int (seconds, non-negative; zero = preset fallback)
# Default: 30
STREAMING_CB_TIMEOUT_S=30

# Maximum drain+flush window on Close, in seconds.  Overridden per-Producer
# by WithCloseTimeout when that option is supplied.  Zero or negative is
# rejected at bootstrap with ErrInvalidConfigField.
# Type: int (seconds, must be > 0)
# Default: 30
STREAMING_CLOSE_TIMEOUT_S=30

# This application's CloudEvents ce-source.  Required when
# STREAMING_ENABLED=true (empty returns ErrMissingSource from LoadConfig).
#
# STRICT SHAPE: a single dot-free lowercase segment matching
# ^[a-z0-9][a-z0-9_-]*$ — e.g. "lender", "midaz-ledger", "br_consignado_gw".
# Anything else returns ErrInvalidSource at bootstrap; v3 never rewrites a
# malformed source (v2's lossy normalization could fold two distinct services
# onto one topic namespace and ACL scope).  The old URI shape
# "//lerian.midaz/<service>" is REJECTED.
#
# It is the sole input to every topic name this application owns:
#   topic           lerian.streaming.<source>            (business facts)
#   commands topic  lerian.streaming.<source>.commands   (service-to-service commands)
#   dlq topic       lerian.streaming.<source>.dlq
# so it must be short enough that the COMMANDS name — the longest of the three
# — fits Kafka's 249-byte limit (223 bytes of source: 249 -
# len("lerian.streaming.") - len(".commands")).  The bound is uniform across
# applications because every app CAN emit commands.  There is deliberately no
# ".commands.dlq".
#
# BOTH SIDES READ IT.  The consumer requires it too, from this same variable,
# because one service has one identity: it names the DLQ a consumer quarantines
# INTO (its own, never the producer's), which is what keeps every application's
# Kafka write grant to its OWN names — three for a command-emitting app, two for
# everyone else — whether it produces, consumes, or both.
# An enabled consumer without it fails Build with ErrConsumerMissingSource.
# Type: string
# Default: ""
STREAMING_CLOUDEVENTS_SOURCE=

# Per-event delivery policy overrides parsed as
# "event.key.enabled=true,event.key.outbox=always,event.key.dlq=never".
# Entries may be separated by commas, semicolons, or newlines. Unknown
# attributes or unsupported values return ErrInvalidDeliveryPolicy.
# Supported attributes:
#   enabled=true|false
#   direct=direct|skip
#   outbox=never|fallback_on_circuit_open|always
#   dlq=never|on_routable_failure
# Bounds: at most 1024 entries; each event key must be <= 256 bytes.
# Type: string
# Default: ""
STREAMING_EVENT_POLICIES=

# ---------------------------------------------------------------------------
# Transport security (TLS + SASL)
#
# All variables below default OFF, so an existing deployment that sets none of
# them keeps its current plaintext dial unchanged.  Enable them from code via
# streaming.NewBuilder().TLSFromConfig(cfg).SASLFromConfig(cfg), which reads
# the parsed values off the loaded Config.  The fail-closed posture is
# preserved: SASL without TLS is rejected unless the RESOLVED allow-plaintext
# setting is explicitly true.  That setting resolves from the canonical
# STREAMING_SASL_ALLOW_PLAINTEXT; when the canonical var is empty the DEPRECATED
# alias STREAMING_ALLOW_PLAINTEXT_SASL=true is honored instead (and LoadConfig
# emits a deprecation warning).  The canonical variable wins when both are set.
# ---------------------------------------------------------------------------

# Enable a TLS broker dial.  When true, the producer connects to brokers over
# TLS using the config built from STREAMING_TLS_CA_CERT.  MinVersion is floored
# at TLS 1.2 and InsecureSkipVerify is never set.
# Type: bool
# Default: false
STREAMING_TLS_ENABLED=false

# Base64-encoded PEM CA certificate added to the dial's RootCAs (private-CA /
# on-prem clusters).  Empty means the host's system trust pool is used.  When
# TLS is enabled, a malformed value fails startup with ErrInvalidTLSConfig; when
# TLS is disabled this value is ignored (TLSFromConfig is a no-op).
# Type: string (base64-encoded PEM)
# Default: ""
STREAMING_TLS_CA_CERT=

# SASL mechanism for broker authentication: PLAIN, SCRAM-SHA-256, or
# SCRAM-SHA-512 (case-insensitive).  Empty disables SASL.  When streaming is
# enabled and SASL validation runs, an unknown value fails startup with
# ErrInvalidSASLMechanism (validation is skipped when streaming is disabled).
# Type: string
# Default: ""
STREAMING_SASL_MECHANISM=

# SASL username.  Required when STREAMING_SASL_MECHANISM is set; when streaming
# is enabled and SASL validation runs, missing credentials fail startup with
# ErrInvalidSASLMechanism (validation is skipped when streaming is disabled).
# Type: string
# Default: ""
STREAMING_SASL_USERNAME=

# SASL password.  SECRET: never logged and never rendered into error strings.
# Required when STREAMING_SASL_MECHANISM is set.  Do not commit a real value.
# Type: string (secret)
# Default: ""
STREAMING_SASL_PASSWORD=

# Allow SASL authentication without TLS.  CANONICAL variable.  This is unsafe
# and intended only for local/dev brokers that do not support TLS; SASL
# credentials would cross the network in cleartext.
# Type: bool
# Default: false
STREAMING_SASL_ALLOW_PLAINTEXT=false

# DEPRECATED alias for STREAMING_SASL_ALLOW_PLAINTEXT (earlier midaz name).
# Consulted only when the canonical variable is unset; using it emits a
# deprecation warning from LoadConfig.  The canonical variable wins when both
# are set.  Prefer STREAMING_SASL_ALLOW_PLAINTEXT.
# Type: bool
# Default: false
STREAMING_ALLOW_PLAINTEXT_SASL=false

# ---------------------------------------------------------------------------
# Automatic topic provisioning (STREAMING_TOPIC_*) — applies to BOTH sides.
#
# Declaring an event is the whole job: at construction each runtime creates the
# topics it owns, derived from declarations it already receives.
#
# THE RULE: a runtime ensures every topic it writes UNDER ITS OWN SOURCE
# NAMESPACE.
#
#   producer Build   -> lerian.streaming.<source>            (its fact topic)
#   producer Build   -> lerian.streaming.<source>.dlq        (its route-DLQ target)
#   consumer Build   -> lerian.streaming.<source>.dlq        (its own DLQ)
#   consumer Build   -> lerian.streaming.<source>.commands   (only when the
#                       consumer names its OWN source in Commands(...))
#
# The DLQ is the same name family on both sides, so an app that both produces
# and consumes ensures it twice — fine and expected, TOPIC_ALREADY_EXISTS is
# silent success.
#
# Nobody provisions a name outside their own namespace.  Subscribing with
# Apps(...), taking another app's Commands(...), or using the raw Topics(...)
# escape hatch creates nothing.  Kafka only; the SQS, RabbitMQ, and EventBridge
# adapters are untouched.
#
# ONE HELD BOUNDARY: a commands queue is never provisioned by its EMITTER.  A
# commands queue lives in the COMMANDING app's namespace — a producer with a
# Class: ClassCommand definition writes lerian.streaming.<its own
# source>.commands, and the addressee subscribes with Commands("<commander>").
# That name is in the emitter's own namespace and is still not created there.
# The ordering expectation is INTENTIONAL: a command emitted before its
# addressee's first deploy FAILS VISIBLY instead of succeeding into a queue
# nobody reads — same posture as subscriptions.
#
# WHY: Lerian brokers run auto_create_topics_enabled=false (correct hardening)
# and the streaming-hub reconciler is read-only by design, so nothing else
# created these topics.  A producer initialized cleanly and its FIRST publish
# failed with UNKNOWN_TOPIC_OR_PARTITION; a consumer on a nonexistent topic is
# INDISTINGUISHABLE from one on an idle topic (franz-go surfaces no
# topic-specific fetch error), so it reported healthy and consumed nothing.
#
# FAILURE POSTURE: a creation that fails logs a WARN naming the topic and the
# missing ACL and startup CONTINUES — it is never a boot failure.  An
# authorization failure is the NORMAL state in a hardened, IaC-provisioned
# environment, so refusing to start there would break the correctly-configured
# deployments.  The CreateTopics round-trip is bounded at 10s (not configurable)
# so a broker outage cannot hang startup — that call is the first and only broker
# I/O Build performs.
#
# ALERTING — the aftermath is NOT symmetric:
#   PUBLISH to a missing topic fails LOUDLY (the error is returned to the
#     caller, class topic_not_found).  This is NOT the outbox absorbing it:
#     outbox fallback covers circuit-open ONLY, and only when a caller wired
#     one — an unwired producer simply gets the error back.
#   CONSUME from a missing topic fails SILENTLY — indistinguishable from an idle
#     subscription, so no error, no metric, and Healthy still passes.  The WARN
#     above is the ONLY signal on that side.  ALERT ON IT.
#
# These three are read where provisioning happens, not through LoadConfig: the
# producer Builder is fluent and never loads Config unless the caller opts in
# with TLSFromConfig / SASLFromConfig, so a knob routed through that struct
# would be silently inert on the default Builder path.
# ---------------------------------------------------------------------------

# Create this application's own declared topics at construction time.  ON by
# default — auto-provisioning is the product default.  Set false in hardened
# environments that pre-provision topics through IaC; construction still
# succeeds, the library simply does not try.
# Type: bool
# Default: true
STREAMING_TOPIC_AUTO_PROVISION=true

# Partition count for auto-created topics.  -1 (the default) sends the Kafka
# "use broker defaults" value, so the count comes from the cluster's
# num.partitions.  That is deliberate: the right partition count is a capacity
# decision belonging to whoever sized the cluster, and a library default would
# silently under-partition every high-throughput stream.  0 and any other
# out-of-range value fall back to -1.
# Type: int
# Default: -1
STREAMING_TOPIC_PARTITIONS=-1

# Replication factor for auto-created topics.  -1 (the default) uses the
# cluster's default.replication.factor.  0 and any other out-of-range value fall
# back to -1.
# Type: int
# Default: -1
STREAMING_TOPIC_REPLICATION_FACTOR=-1

# ---------------------------------------------------------------------------
# Consumer (STREAMING_CONSUMER_*) — the at-least-once group consumer.
# Read by streaming.LoadConsumerConfig(), which is adopted by the builder via
# streaming.NewConsumer().FromConfig(cfg).  Without FromConfig none of these
# variables is read by anything.  TLS/SASL are wired programmatically only
# (builder setters), never from the environment — secrets do not belong in
# env-string config.
#
#   cfg, warnings, err := streaming.LoadConsumerConfig()
#   c, err := streaming.NewConsumer().FromConfig(cfg).
#       OnFrom("lender", "loan.disbursed", h).Build(ctx)
#
# NOTE: the consumer also requires STREAMING_CLOUDEVENTS_SOURCE (documented in
# the producer section above) — it names this application's own DLQ topic.
# ---------------------------------------------------------------------------

# Master kill switch for the consumer.  When false, Build returns a no-op
# Consumer whose Run blocks until ctx-cancel.
# Type: bool
# Default: false
STREAMING_CONSUMER_ENABLED=false

# Kafka/Redpanda bootstrap brokers (csv).  Required when enabled.
# Type: string (csv)
# Default: ""
STREAMING_CONSUMER_BROKERS=

# Consumer group id.  Required when enabled.
# Type: string
# Default: ""
STREAMING_CONSUMER_GROUP=

# PRODUCING APPLICATIONS whose FACTS to subscribe to, by ce-source (csv).  Each
# resolves to that application's fact topic, "lerian.streaming.<app>", so a
# consumer never hardcodes the derivation.  Each name is held to the same strict
# source contract the producer enforces.  For the applications that COMMAND this
# one, use STREAMING_CONSUMER_COMMANDS instead; the two compose.
#
# Naming apps here also arms the consumer's built-in source verification: an
# event whose ce-source is not one of these is quarantined instead of
# dispatched (previously hand-rolled in every consuming repo).
#
# At least one of STREAMING_CONSUMER_APPS, STREAMING_CONSUMER_COMMANDS, or
# STREAMING_CONSUMER_TOPICS must be set when enabled.  All three SUBSCRIPTIONS
# compose, but setting a named app (APPS or COMMANDS) TOGETHER with raw TOPICS
# and no STREAMING_CONSUMER_EXPECT_SOURCES is a HARD BUILD FAILURE: the derived
# allowlist would quarantine 100% of the raw topics, whose producers were never
# named, and skipping verification would drop the check the subscription paid
# for.  State the allowlist explicitly.
# Example: lender,matcher
# Type: string (csv)
# Default: ""
STREAMING_CONSUMER_APPS=

# APPLICATIONS THAT COMMAND THIS ONE, by ce-source (csv).  Each resolves to that
# application's commands queue, "lerian.streaming.<app>.commands", and feeds the
# same ce-source allowlist STREAMING_CONSUMER_APPS fills.  Each name is held to
# the same strict source contract the producer enforces.
#
# It composes with STREAMING_CONSUMER_APPS: naming lender in BOTH subscribes to
# lender's fact topic AND lender's commands queue — two subscriptions, one
# deduped allowlist entry — which is the ordinary shape for a service that
# watches a producer and is also commanded by it.
#
# What it changes is the UNMATCHED VERDICT.  On a fact topic an event key with
# no registered handler is skipped and committed; on a commands queue it is
# QUARANTINED to this consumer's own DLQ with cause kind "unhandled_key".  A
# command is work addressed to THIS consumer, so a key it cannot handle is
# undelivered work, not noise — without this, a producer shipping a new command
# key before its consumer deploys the handler loses every one of them, forever,
# with green dashboards on both sides.  The strictness is NOT configurable and
# STREAMING_CONSUMER_* has no knob to loosen it.
#
# Requires per-event dispatch (OnFrom/On).  A whole-stream Handler(...) has no
# handler registry to ask, so that combination fails Build.
# Example: lender
# Type: string (csv)
# Default: ""
STREAMING_CONSUMER_COMMANDS=

# RAW subscription list (csv) — the escape hatch for topics this library did
# not derive (legacy streams, third-party producers).  Prefer
# STREAMING_CONSUMER_APPS for lib-streaming producers.
#
# Setting this TOGETHER with STREAMING_CONSUMER_APPS requires
# STREAMING_CONSUMER_EXPECT_SOURCES; see that variable and the note above.
# Type: string (csv)
# Default: ""
STREAMING_CONSUMER_TOPICS=

# Explicit ce-source allowlist (csv) for source verification.
#
# It REPLACES the allowlist STREAMING_CONSUMER_APPS and STREAMING_CONSUMER_COMMANDS
# would have implied, and it must COVER every app named in EITHER — subscribing to an app's topic while
# refusing its ce-source quarantines that whole stream, which is always a bug.
# Each entry is held to the same strict source contract the producer enforces
# (^[a-z0-9][a-z0-9_-]*$); a typo fails at load, because it would otherwise
# quarantine every record while the consumer reported healthy.
#
# Set it when a named app (STREAMING_CONSUMER_APPS or STREAMING_CONSUMER_COMMANDS)
# and STREAMING_CONSUMER_TOPICS are both used: it is the only way to resolve that
# refusal from the environment.  A
# programmatic ConsumerBuilder.ExpectSources(...) call overrides this value.
#
# Verification runs in the consumer RUNTIME, ahead of the handler, so this
# applies in BOTH handler modes — per-event OnFrom(...)/On(...) dispatch AND a
# whole-stream Handler(...).  The Handler mode is the one that needs it most: it
# receives every record on a topic whose write ACL it does not own.  (Setting
# this fleet-wide used to CrashLoop every Handler-mode service; that build error
# is gone.)  A mismatch quarantines with x-lerian-dlq-cause-kind=source_mismatch.
# Example: lender,matcher,legacy-writer
# Type: string (csv)
# Default: ""
STREAMING_CONSUMER_EXPECT_SOURCES=

# Kafka client.id for broker-side diagnostics.
# Type: string
# Default: ""
STREAMING_CONSUMER_CLIENT_ID=

# IN-LOOP transient-retry attempts per record within one poll cycle (the
# connection-blip absorber).  NOT "retries before DLQ": transients never reach
# the DLQ.  A sustained transient seeks back and blocks its partition.
# Type: int
# Default: 3
STREAMING_CONSUMER_RETRY_BUDGET=3

# First in-loop transient-retry backoff, milliseconds.
# Type: int (ms)
# Default: 100
STREAMING_CONSUMER_RETRY_BACKOFF_INITIAL_MS=100

# Per-attempt in-loop backoff ceiling, milliseconds.
# Type: int (ms)
# Default: 5000
STREAMING_CONSUMER_RETRY_BACKOFF_MAX_MS=5000

# HARD CAP on aggregate in-loop dwell per record, milliseconds.  Must stay well
# below the group rebalance/session timeout: the member holds
# BlockRebalanceOnPoll for the batch.  Rejected above 30000.
# Type: int (ms)
# Default: 1000
STREAMING_CONSUMER_RETRY_INLOOP_MAX_DWELL_MS=1000

# CROSS-POLL pause before re-polling when any partition was halted.  The group
# is unblocked during this wait, so it may safely grow for a slow downstream.
# Type: int (ms)
# Default: 250
STREAMING_CONSUMER_HALT_BACKOFF_MS=250

# Cap on a single PollFetches wait, so a poll cycle COMPLETES on a quiet topic
# and readiness can pass without traffic.  0 resolves to the 15000 default;
# there is deliberately no "block forever" setting — that was the readiness
# deadlock (an idle topic never completed a cycle, so Healthy never passed).
# This is a readiness knob, not a throughput knob: a busy topic returns long
# before the deadline, and raising it only delays the FIRST ready on an empty
# topic.  Keep it well under the group session timeout (~45s).
# Type: int (ms)
# Default: 15000
STREAMING_CONSUMER_POLL_TIMEOUT_MS=15000

# Graceful drain bound on Close, seconds.
# Type: int (s)
# Default: 30
STREAMING_CONSUMER_CLOSE_TIMEOUT_S=30

# NOTE: there is deliberately NO STREAMING_CONSUMER_DLQ_SUFFIX.  The DLQ topic
# is always "lerian.streaming.<app>.dlq" — the PRODUCING app's own for a
# producer, the CONSUMING app's own for a consumer — owned by the library and
# derived from STREAMING_CLOUDEVENTS_SOURCE.  The whole point of the topic
# collapse is that a producer's Kafka ACL covers only its OWN names —
# lerian.streaming.<app>, its .commands if it commands anyone, and its .dlq —
# and a free-text suffix could rename one of them out from under that grant.
# There is likewise no .commands.dlq: a consumer quarantines into its own .dlq
# and a producer route-DLQs a failed command publish into its own.
